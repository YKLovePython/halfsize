{
  "name": "halfsize",
  "version": "0.1.5",
  "description": "Compress any video to an exact target size, locally, and prove the quality did not drop.",
  "type": "module",
  "bin": {
    "halfsize": "bin/halfsize.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKLovePython/halfsize.git"
  },
  "homepage": "https://github.com/YKLovePython/halfsize#readme",
  "bugs": {
    "url": "https://github.com/YKLovePython/halfsize/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/halfsize.mjs",
    "web": "node bin/halfsize.mjs --web",
    "test": "node --test test/human.test.mjs test/plan.test.mjs test/quality.test.mjs test/cli.test.mjs test/e2e.test.mjs"
  },
  "keywords": [
    "video",
    "compress",
    "compress-video",
    "video-compression",
    "video-compressor",
    "reduce-video-size",
    "ffmpeg",
    "target-size",
    "vmaf",
    "ssim",
    "discord",
    "wechat",
    "whatsapp",
    "cli",
    "privacy",
    "windows",
    "macos",
    "linux"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
