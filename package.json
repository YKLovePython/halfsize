{
  "name": "halfsize",
  "version": "0.1.10",
  "description": "Compress any video to an exact size (Discord or WeChat 20 MB, WhatsApp 16 MB) locally with FFmpeg and verify the quality with VMAF/SSIM.",
  "type": "module",
  "bin": {
    "halfsize": "bin/halfsize.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKLovePython/halfsize.git"
  },
  "homepage": "https://YKLovePython.github.io/halfsize/",
  "bugs": {
    "url": "https://github.com/YKLovePython/halfsize/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/halfsize.mjs",
    "web": "node bin/halfsize.mjs --web",
    "test": "node --test test/human.test.mjs test/plan.test.mjs test/quality.test.mjs test/cli.test.mjs test/version.test.mjs test/encode.test.mjs test/server.test.mjs test/e2e.test.mjs"
  },
  "keywords": [
    "video",
    "compress",
    "compress-video",
    "video-compression",
    "video-compressor",
    "reduce-video-size",
    "ffmpeg",
    "target-size",
    "vmaf",
    "ssim",
    "discord",
    "wechat",
    "whatsapp",
    "cli",
    "privacy",
    "windows",
    "macos",
    "linux"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
