{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.YKLovePython/halfsize",
  "title": "halfsize",
  "description": "Compress a video to an exact byte size locally with FFmpeg, then measure VMAF and SSIM.",
  "version": "0.2.0",
  "websiteUrl": "https://YKLovePython.github.io/halfsize/",
  "repository": {
    "url": "https://github.com/YKLovePython/halfsize",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "halfsize",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-y"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
